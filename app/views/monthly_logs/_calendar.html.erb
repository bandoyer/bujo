<section class="monthly-calendar" aria-label="<%= @month.strftime("%B %Y") %> calendar">
  <% @month.all_month.each do |day| %>
    <% day_entries = @entries_by_date.fetch(day, []) %>
    <% panel_id = "calendar_capture_#{day.iso8601}" %>
    <article class="monthly-calendar__day <%= "monthly-calendar__day--today" if day == @today %>"
             data-controller="placement task-actions"
             data-page-capture="monthly_calendar"
             data-date="<%= day.iso8601 %>">
      <% weekday_letter = day.strftime("%a").first.upcase %>
      <% if @capture_open %>
        <button type="button"
                class="monthly-calendar__capture-reveal"
                aria-label="Write on Calendar for <%= day.strftime("%B %-d") %>"
                aria-expanded="false"
                aria-controls="<%= panel_id %>"
                data-placement-target="toggle"
                data-action="placement#toggle">
          <span class="monthly-calendar__number"><%= day.day %></span>
          <span class="monthly-calendar__weekday"><%= weekday_letter %></span>
        </button>
      <% else %>
        <div class="monthly-calendar__date">
          <span class="monthly-calendar__number"><%= day.day %></span>
          <span class="monthly-calendar__weekday"><%= weekday_letter %></span>
        </div>
      <% end %>

      <div class="monthly-calendar__residents">
        <% day_entries.each do |entry| %>
          <div id="monthly_entry_<%= entry.id %>">
            <%= render "entries/entry",
                       entry: entry,
                       viewed_on: @month,
                       return_to: "monthly_calendar" %>
          </div>
        <% end %>
      </div>

      <%= link_to "›",
                  daily_log_path(date: day.iso8601),
                  class: "monthly-calendar__daily-link",
                  aria: { label: "Open Daily Log for #{day.strftime("%B %-d, %Y")}" } %>

      <% if @capture_open %>
        <div id="<%= panel_id %>" class="monthly-calendar__capture-panel" data-placement-target="panel" hidden>
          <%= render "entries/rapid_log_form",
                     capture_date: day,
                     placement: "monthly_calendar",
                     allowed_kinds: %w[task event note],
                     form_id: "calendar_form_#{day.iso8601}" %>
        </div>
      <% end %>
    </article>
  <% end %>
</section>
