<% content_for :title, "Forgot your password?" %>

<main class="auth-sheet">
  <h1>Forgot your password?</h1>
  <%= render "shared/auth_alerts" %>
  <%= form_with url: passwords_path, class: "auth-form" do |form| %>
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
      autocomplete: "username", autocapitalize: "none", spellcheck: false,
      placeholder: "you@example.com", value: params[:email_address] %>
    <%= form.submit "Email reset instructions", class: "auth-primary" %>
  <% end %>
  <div class="auth-method-switch">
    <%= link_to "Back to sign in", new_session_path(method: "password"), class: "auth-secondary" %>
  </div>
  <%= render "shared/auth_brand" %>
</main>
