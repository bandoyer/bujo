<% content_for :title, "Daily Reflection · Bujo" %>
<% content_for :deferred_flash, true %>
<main class="page-shell daily-reflection" data-controller="task-actions">
  <h1 class="page-shell__title">Daily Reflection</h1>
  <p class="daily-reflection__date"><%= @today.strftime("%A · %B %-d").upcase %></p>
  <div class="daily-reflection__preferences">
    <%= render "themes/toggle" %>
    <%= render "letterings/toggle" %>
  </div>
  <%= render "daily_reflections/mode_switch", mode: mode %>
  <div id="flash_messages"><%= render "shared/flash_messages" %></div>
  <%= yield %>
  <%= render "shared/tab_bar", active: :today %>
</main>
