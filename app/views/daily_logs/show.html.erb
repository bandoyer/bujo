<% content_for :title, "Daily Log · Bujo" %>

<main class="daily-log">
  <header class="daily-log__header">
    <div class="daily-log__heading">
      <p class="daily-log__eyebrow"><%= @date.strftime("%a · %b %-d").upcase %></p>
      <h1>Daily Log</h1>
    </div>

    <div class="daily-log__utilities">
      <%= render "themes/toggle" %>
      <%= render "open_task_count", count: @open_task_count %>
    </div>

    <nav class="day-navigation" aria-label="Daily Log days">
      <%= link_to "‹", daily_log_path(date: (@date - 1.day).iso8601), aria: { label: "Previous day" } %>
      <% if @date != Time.zone.today %>
        <%= link_to "today", daily_log_path(date: Time.zone.today.iso8601), class: "day-navigation__today" %>
      <% end %>
      <%= link_to "›", daily_log_path(date: (@date + 1.day).iso8601), aria: { label: "Next day" } %>
    </nav>
  </header>

  <section class="entry-list" id="entries" aria-label="Entries">
    <% if @entries.empty? %>
      <p class="entry-list__empty" id="empty_daily_log">Nothing logged yet.</p>
    <% else %>
      <%= render partial: "entries/entry", collection: @entries, locals: { viewed_on: @date } %>
    <% end %>
  </section>

  <% if @date == Time.zone.today %>
    <%= render "entries/rapid_log_form" %>
  <% end %>

  <nav class="tab-bar" aria-label="Journal sections">
    <span class="tab-bar__item tab-bar__item--active" aria-current="page"><span>•</span>Today</span>
    <button class="tab-bar__item" type="button" disabled><span>▦</span>Month</button>
    <button class="tab-bar__item" type="button" disabled><span>›</span>Future</button>
    <button class="tab-bar__item" type="button" disabled><span>⌕</span>Index</button>
  </nav>
</main>
