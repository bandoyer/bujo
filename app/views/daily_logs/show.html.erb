<% content_for :title, "Daily Log · Bujo" %>
<% content_for :deferred_flash, true %>
<%# The controller owns the clock; the screen only asks which day it holds. %>
<% viewing_today = @date == @today %>
<% viewed_day_label = @date.strftime("%a · %b %-d").upcase %>

<main class="page-shell daily-log" data-controller="placement">
  <header class="page-shell__header daily-log__header">
    <div class="daily-log__heading">
      <h1 class="page-shell__title">Daily Log</h1>
    </div>

    <div class="daily-log__utilities">
      <div class="daily-log__preferences">
        <%= render "themes/toggle" %>
        <%= render "letterings/toggle" %>
      </div>
      <%= render "open_task_count", count: @open_task_count %>
    </div>

    <nav class="day-navigation" aria-label="Daily Log days">
      <%= link_to "‹", daily_log_path(date: (@date - 1.day).iso8601), aria: { label: "Previous day" } %>
      <span class="day-navigation__viewed-day"><%= viewed_day_label %></span>
      <%= link_to "›", daily_log_path(date: (@date + 1.day).iso8601), aria: { label: "Next day" } %>
    </nav>
    <% if viewing_today %>
      <%= link_to "Reflect", reflection_path,
                  class: "visually-hidden daily-reflection-entry action action--surface action--link" %>
    <% end %>
  </header>
  <div id="flash_messages"><%= render "shared/flash_messages" %></div>

  <section class="entry-list" id="entries" aria-label="Entries" data-controller="task-actions">
    <% if @entries.empty? && !@capture_open %>
      <p class="state-text state-text--empty state-text--handwritten entry-list__empty" id="empty_daily_log">Nothing logged yet.</p>
    <% elsif @entries.any? %>
      <%= render partial: "entries/entry", collection: @entries, locals: { viewed_on: @date } %>
    <% end %>
  </section>

  <% if @capture_open %>
    <section class="daily-log__capture">
      <button type="button"
              id="capture_reveal"
              class="daily-log__capture-reveal"
              aria-label="Write on this page"
              aria-expanded="false"
              aria-controls="rapid_log_panel"
              data-placement-target="toggle"
              data-action="placement#toggle">
        <% if @entries.empty? %>
          <span class="state-text state-text--empty state-text--handwritten entry-list__empty" id="empty_daily_log">Nothing logged yet.</span>
        <% end %>
      </button>
      <div id="rapid_log_panel" class="daily-log__capture-panel" data-placement-target="panel" hidden>
        <% unless viewing_today %>
          <p class="daily-log__capture-cue">→ logging to <%= @date.strftime("%b %-d").upcase %></p>
        <% end %>
        <%= render "entries/rapid_log_form", capture_date: @date %>
      </div>
    </section>
  <% end %>

  <%= render "shared/tab_bar", active: :today %>
</main>
