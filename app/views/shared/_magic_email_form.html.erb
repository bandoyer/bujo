<%= form_with url: sign_in_link_path, class: "auth-form auth-form--compact" do |form| %>
  <%= form.label :email_address, "Email" %>
  <%= form.email_field :email_address, required: true, autofocus: true,
    autocomplete: "email", autocapitalize: "none", spellcheck: false,
    placeholder: "you@example.com", value: params[:email_address] %>
  <%= form.submit "Email me a sign-in link", class: "auth-primary" %>
  <p class="auth-form__note">A one-time link, with nothing to remember.</p>
<% end %>
<div class="auth-method-switch">
  <%= link_to "Use password instead", new_session_path(method: "password"), class: "auth-secondary" %>
</div>
