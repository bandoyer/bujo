<nav class="tab-bar" aria-label="Journal sections">
  <%= link_to root_path,
              class: class_names("tab-bar__item", "tab-bar__item--active": active == :today),
              aria: { current: ("page" if active == :today) } do %>
    <%= render layout: "shared/tab_icon" do %>
      <circle cx="12" cy="12" r="8"></circle>
      <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
    <% end %>
    <span>Today</span>
  <% end %>
  <%= link_to monthly_log_path,
              class: class_names("tab-bar__item", "tab-bar__item--active": active == :month),
              aria: { current: ("page" if active == :month) } do %>
    <%= render layout: "shared/tab_icon" do %>
      <rect x="4" y="5" width="16" height="15" rx="2"></rect>
      <path d="M8 3v4M16 3v4M4 9h16M8 13h2M14 13h2M8 17h2M14 17h2"></path>
    <% end %>
    <span>Month</span>
  <% end %>
  <%= link_to future_log_path,
              class: class_names("tab-bar__item", "tab-bar__item--active": active == :future),
              aria: { current: ("page" if active == :future) } do %>
    <%= render layout: "shared/tab_icon" do %>
      <path d="m5 6 6 6-6 6M13 6l6 6-6 6"></path>
    <% end %>
    <span>Future</span>
  <% end %>
  <%= link_to journal_index_path,
              class: class_names("tab-bar__item", "tab-bar__item--active": active == :index),
              aria: { current: ("page" if active == :index) } do %>
    <%= render layout: "shared/tab_icon" do %>
      <path d="M6 6h12M6 12h12M6 18h12"></path>
    <% end %>
    <span>Index</span>
  <% end %>
</nav>
