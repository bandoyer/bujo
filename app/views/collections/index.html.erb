<% content_for :title, "Index · Bujo" %>

<main class="page-shell daily-log collection-page collection-index" data-controller="placement">
  <header class="page-shell__header daily-log__header collection-page__header">
    <div class="collection-page__heading">
      <h1 class="page-shell__title">Index</h1>
      <p class="collection-page__context">Your collections</p>
    </div>
    <button type="button"
            id="new_collection_toggle"
            class="action action--surface collection-page__button"
            aria-expanded="<%= @new_collection_open ? "true" : "false" %>"
            aria-controls="new_collection_panel"
            data-placement-target="toggle"
            data-action="placement#toggle">New Collection</button>
  </header>

  <section id="new_collection_panel"
           class="collection-panel"
           data-placement-target="panel"
           <%= "hidden" unless @new_collection_open %>>
    <% if @form_errors.present? %>
      <p class="state-text form-errors"><%= @form_errors.to_sentence %></p>
    <% end %>
    <%= form_with model: @new_collection, class: "collection-form" do |form| %>
      <%= form.label :name, "Topic", class: "field-label" %>
      <%= form.text_field :name,
                          value: @new_collection_name,
                          autocomplete: "off",
                          class: "field",
                          data: { placement_target: "focus" } %>
      <%= form.submit "Create", class: "action action--surface collection-page__button" %>
    <% end %>
  </section>

  <% if @collections.empty? %>
    <p class="state-text state-text--empty collection-index__empty">Nothing indexed yet.</p>
  <% else %>
    <nav class="collection-index__topics" aria-label="Indexed Collections">
      <% @collections.each do |collection| %>
        <%= link_to collection.name, collection_path(collection), class: "action collection-index__topic-link" %>
      <% end %>
    </nav>
  <% end %>

  <button type="button"
          id="index_create_reveal"
          class="collection-index__create-reveal"
          aria-label="New Collection"
          aria-expanded="false"
          aria-controls="new_collection_panel"
          data-placement-target="toggle"
          data-action="placement#toggle"></button>

  <%= render "shared/tab_bar", active: :index %>
</main>
