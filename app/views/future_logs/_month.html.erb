<%# One month of the runway: its header, which doubles as the reveal control
    for writing under it, the add row, and the month's entries. %>
<% month_key = month.strftime("%Y_%m") %>
<% add_row_id = "future_month_#{month_key}_add" %>
<%# Only a month after the current one takes new entries; the rest render. %>
<% add_open = month_add_open?(month) %>
<section class="future-log__month <%= "future-log__month--empty" if entries.empty? %>"
         data-month="<%= month.strftime("%Y-%m") %>">
  <h2>
    <% if add_open %>
      <button type="button"
              id="future_month_<%= month_key %>_toggle"
              aria-expanded="false"
              aria-controls="<%= add_row_id %>"
              data-placement-target="toggle"
              data-action="placement#toggle"><%= month.strftime("%B %Y").upcase %></button>
    <% else %>
      <span><%= month.strftime("%B %Y").upcase %></span>
    <% end %>
  </h2>
  <div id="<%= future_month_entries_id(month) %>" class="future-log__entries">
    <%= render partial: "future_logs/entry", collection: entries %>
  </div>
  <% if add_open %>
    <button type="button"
            id="future_month_<%= month_key %>_trailing_toggle"
            class="future-log__trailing-reveal"
            aria-label="Write in <%= month.strftime("%B %Y") %>"
            aria-expanded="false"
            aria-controls="<%= add_row_id %>"
            data-placement-target="toggle"
            data-action="placement#toggle"></button>
    <div id="<%= add_row_id %>" class="future-log__add-row" data-placement-target="panel" hidden>
      <%= render "entries/rapid_log_form",
                 capture_date: nil,
                 placement: "future",
                 allowed_kinds: %w[task event],
                 form_id: "future_month_#{month_key}_form",
                 line_id: "future_month_#{month_key}_line",
                 future_month: month %>
    </div>
  <% end %>
</section>
