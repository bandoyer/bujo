<% content_for :title, "Future Log · Bujo" %>
<% content_for :deferred_flash, true %>

<main class="page-shell daily-log future-log" data-controller="placement task-actions">
  <header class="page-shell__header daily-log__header future-log__header">
    <div class="page-shell__heading daily-log__heading">
      <h1 class="page-shell__title">Future Log</h1>
    </div>
  </header>
  <div id="flash_messages"><%= render "shared/flash_messages" %></div>

  <section class="future-log__runway" aria-label="Upcoming entries">
    <% @months.each do |month| %>
      <%= render "future_logs/month", month: month, entries: @entries_by_month.fetch(month, []) %>
    <% end %>
  </section>

  <%= render "shared/tab_bar", active: :future %>
</main>
