<%= render layout: "monthly_migrations/shell", locals: { stage: "Fresh mental inventory" } do %>
  <section class="monthly-migration__inventory" aria-label="<%= @target_month.strftime('%B %Y') %> Tasks">
    <% if @target_entries.empty? %>
      <p class="entry-list__empty">Nothing in <%= @target_month.strftime("%B") %> Tasks yet.</p>
    <% else %>
      <div class="entry-list">
        <%= render partial: "monthly_migrations/tree_entry",
                   collection: @target_entries,
                   as: :entry,
                   locals: { candidate: nil, stage: :setup } %>
      </div>
    <% end %>
  </section>

  <%= form_with url: monthly_migration_inventory_path(month: target_param),
                class: "monthly-migration__capture",
                data: { controller: "rapid-log" } do |form| %>
    <%= render "entries/kind_buttons", allowed_kinds: %w[task] %>
    <%= form.hidden_field :default_kind, value: "task", data: { rapid_log_target: "kind" } %>
    <%= form.label :line, "What matters this month?", for: "monthly_migration_line" %>
    <div class="monthly-migration__capture-row">
      <%= form.text_field :line,
                          id: "monthly_migration_line",
                          value: @line,
                          autocomplete: "off",
                          data: { rapid_log_target: "line" } %>
      <%= form.submit "Log task", class: "monthly-migration__button" %>
    </div>
  <% end %>

  <%= link_to "Review outgoing tasks",
              monthly_migration_outgoing_path(month: target_param),
              class: "monthly-migration__primary-link" %>
<% end %>
