<%# The right-aligned mono column: time, tags, and a migrated task's destination. %>
<span class="entry__meta">
  <% if entry.time_of_day.present? %><span><%= entry.time_of_day %></span><% end %>
  <% entry.tags.each do |tag| %><span>+<%= tag %></span><% end %>
  <% if entry.successor %>
    <%# Dated successors name their day; a Collection successor instead names
        the Topic that gives its new page meaning. %>
    <% destination_date = entry.successor.occurs_on || entry.successor.page_on %>
    <% destination = entry.successor.collection&.name || destination_date&.strftime("%b %-d")&.upcase %>
    <span>→<%= " #{destination}" if destination %></span>
  <% end %>
</span>
