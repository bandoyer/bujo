<%# Lifecycle controls for a task row. Each posts the day being viewed so the
    redirect lands back where the reader was, not on today. The row already
    resolved which commands it may offer; this strip only renders them. %>
<% viewed_on_iso = viewed_on.iso8601 %>
<% return_params = { viewed_on: viewed_on_iso, return_to: return_to }.compact %>
<% schedule_open = local_assigns.fetch(:schedule_open, false) %>
<div id="<%= action_strip_id %>" class="entry__action-strip" data-task-actions-target="strip" <%= "hidden" unless edit_open || schedule_open %>>
  <div class="action-row entry__actions" data-step="actions" <%= "hidden" if edit_open || schedule_open %>>
    <% if offered_commands.include?("update") %>
      <button type="button" class="action action--surface action--muted entry-action" data-action="task-actions#showEdit">Edit</button>
    <% end %>
    <% if offered_commands.include?("complete") %>
      <%= button_to "Complete", complete_entry_path(entry), params: return_params, class: "action action--surface action--muted entry-action" %>
    <% end %>
    <% if offered_commands.include?("strike") %>
      <%= button_to "Strike", strike_entry_path(entry), params: return_params, class: "action action--surface action--muted action--warn entry-action entry-action--warn" %>
    <% end %>
    <% if offered_commands.include?("migrate") %>
      <%= button_to "Migrate", migrate_entry_path(entry), params: return_params, class: "action action--surface action--muted entry-action" %>
    <% end %>
    <% if offered_commands.include?("reopen") %>
      <%= button_to "Reopen", reopen_entry_path(entry), params: return_params, class: "action action--surface action--muted entry-action" %>
    <% end %>
    <% if offered_commands.include?("schedule") %>
      <% if local_assigns[:schedule_open_path] %>
        <%= button_to "Schedule…", schedule_open_path, method: :get,
                      params: { schedule: schedule_entry_id },
                      class: "action action--surface action--muted entry-action" %>
      <% else %>
        <button type="button" class="action action--surface action--muted entry-action" data-action="task-actions#showSchedule">Schedule…</button>
      <% end %>
    <% end %>
    <% if offered_commands.include?("move_to_collection") %>
      <button type="button" class="action action--surface action--muted entry-action" data-action="task-actions#showMove">Move to Collection…</button>
    <% end %>
  </div>

  <% if offered_commands.include?("update") %>
    <div class="action-row entry__edit-step" data-step="edit" <%= "hidden" unless edit_open %>>
      <%= form_with url: entry_path(entry), method: :patch,
                    class: "entry__edit", data: { controller: "rapid-log" } do |form| %>
        <%= render "entries/kind_buttons", allowed_kinds: entry.correctable_kinds, selected_kind: entry.kind %>
        <%= form.hidden_field :default_kind, value: entry.kind, data: { rapid_log_target: "kind" } %>
        <%= form.label :line, "Edit entry", for: "edit_line_#{entry.id}", class: "field-label" %>
        <div class="entry__edit-row">
          <%= form.text_field :line,
                              id: "edit_line_#{entry.id}",
                              value: (edit_open ? flash[:edit_line] : entry.canonical_edit_line),
                              required: true,
                              autofocus: edit_open,
                              autocomplete: "off",
                              class: "field",
                              data: { rapid_log_target: "line" } %>
          <%= form.submit "Save", class: "action action--surface action--muted entry-action" %>
        </div>
      <% end %>
      <button type="button"
              class="action action--surface action--muted entry-action entry-action--cancel"
              data-action="task-actions#cancelStep">Cancel</button>
    </div>
  <% end %>

  <%# The date step belongs only to a row that may actually schedule, so a
      Collection row never carries a hidden second step it can never reach. %>
  <% if offered_commands.include?("schedule") %>
    <div class="action-row entry__schedule-step" data-step="schedule" <%= "hidden" unless schedule_open %>>
      <%= form_with url: schedule_entry_path(entry), class: "entry__schedule" do |form| %>
        <%= form.hidden_field :viewed_on, value: viewed_on_iso %>
        <%= form.hidden_field :return_to, value: return_to if return_to %>
        <%= form.label :date, "Schedule for", class: "field-label" %>
        <%= form.date_field :date, required: true, autofocus: schedule_open, class: "field field--muted" %>
        <div class="action-row entry__schedule-actions">
          <%= form.submit "Schedule", class: "action action--surface action--muted entry-action" %>
          <button type="button"
                  class="action action--surface action--muted entry-action entry-action--cancel"
                  data-action="task-actions#cancelStep">Cancel</button>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if offered_commands.include?("move_to_collection") %>
    <% move_topic_id = "move_topic_#{entry.id}" %>
    <div class="action-row entry__move-step" data-step="move" hidden>
      <%= form_with url: move_to_collection_entry_path(entry), class: "action-row entry__move" do |form| %>
        <%= form.hidden_field :viewed_on, value: viewed_on_iso %>
        <%= form.hidden_field :return_to, value: return_to if return_to %>
        <%= form.label :topic, "Exact Topic", for: move_topic_id, class: "visually-hidden" %>
        <%= form.text_field :topic, id: move_topic_id, required: true, autocomplete: "off", class: "field field--muted" %>
        <%= form.submit "Move", class: "action action--surface action--muted entry-action" %>
      <% end %>
      <button type="button"
              class="action action--surface action--muted entry-action entry-action--cancel"
              aria-label="Cancel moving to Collection"
              data-action="task-actions#cancelStep">×</button>
    </div>
  <% end %>
</div>
