<%# The bullet vocabulary a capture form offers. Every capture surface shows the
    same three buttons in the same order, narrowed to the kinds its page admits
    at root, so one page's glyph strip never drifts from another's. %>
<% selected_kind = local_assigns.fetch(:selected_kind, "task") %>
<div class="rapid-log__kinds" aria-label="Entry kind">
  <% { "task" => "•", "event" => hand_glyph("○"), "note" => "–" }.each do |kind, glyph| %>
    <% next unless allowed_kinds.include?(kind) %>
    <% selected = kind == selected_kind %>
    <button type="button"
            class="rapid-log__kind <%= "rapid-log__kind--selected" if selected %>"
            aria-label="<%= kind.capitalize %>"
            aria-pressed="<%= selected %>"
            data-rapid-log-target="kindButton"
            data-action="rapid-log#selectKind"
            data-kind="<%= kind %>"><%= glyph %></button>
  <% end %>
</div>
