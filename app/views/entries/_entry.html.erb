<%# One journal row: its bullet line, its hidden lifecycle controls, then its children. %>
<% muted = entry.state.in?(%w[done migrated]) %>
<% return_to = local_assigns[:return_to] %>
<%# One list decides both the toggle and the strip's contents, so a row is a
    toggle exactly when there is something behind it to reach. %>
<% offered_commands = offered_entry_commands(entry) %>
<article id="entry_<%= entry.id %>" class="entry <%= "entry--muted" if muted %>" data-entry-id="<%= entry.id %>">
  <%# An actionable row is a toggle and the strip it controls; anything else is
      a plain line. The strip sits between the line and the children region. %>
  <% if offered_commands.any? %>
    <% action_strip_id = "entry_#{entry.id}_actions" %>
    <button type="button"
            class="entry__line entry__toggle"
            aria-expanded="false"
            aria-controls="<%= action_strip_id %>"
            data-task-actions-target="toggle"
            data-action="task-actions#toggle">
      <%= render "entries/entry_line", entry: entry %>
    </button>
    <%= render "entries/task_actions",
               entry: entry,
               viewed_on: viewed_on,
               return_to: return_to,
               offered_commands: offered_commands,
               action_strip_id: action_strip_id %>
  <% else %>
    <div class="entry__line">
      <%= render "entries/entry_line", entry: entry %>
    </div>
  <% end %>

  <% children = entry.children.kept %>
  <% if children.any? %>
    <div class="entry__children">
      <%= render partial: "entries/entry",
                 collection: children,
                 locals: { viewed_on: viewed_on, return_to: return_to } %>
    </div>
  <% end %>
</article>
