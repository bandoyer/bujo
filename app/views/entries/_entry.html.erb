<% muted = entry.state.in?(%w[done migrated]) %>
<article id="entry_<%= entry.id %>" class="entry <%= "entry--muted" if muted %>" data-entry-id="<%= entry.id %>">
  <div class="entry__line">
    <span class="entry__signifier" aria-label="<%= entry.priority? ? "Priority" : "Not priority" %>"><%= "*" if entry.priority? %></span>
    <span class="entry__glyph"><%= entry.glyph %></span>
    <span class="entry__text <%= "entry__text--struck" if entry.state == "struck" %>"><%= entry.text %></span>
    <span class="entry__meta">
      <% if entry.time_of_day.present? %><span><%= entry.time_of_day %></span><% end %>
      <% entry.tags.each do |tag| %><span>+<%= tag %></span><% end %>
      <% if entry.state == "migrated" && entry.successor %>
        <% destination = entry.successor.occurs_on || entry.successor.logged_on %>
        <span>→ <%= destination.strftime("%b %-d").upcase %></span>
      <% end %>
    </span>
  </div>

  <% if entry.kind == "task" %>
    <div class="entry__actions">
      <% if entry.state == "open" %>
        <%= button_to "Complete", complete_entry_path(entry), params: { viewed_on: viewed_on.iso8601 }, class: "entry-action" %>
        <%= button_to "Strike", strike_entry_path(entry), params: { viewed_on: viewed_on.iso8601 }, class: "entry-action entry-action--warn" %>
        <%= button_to "Migrate", migrate_entry_path(entry), params: { viewed_on: viewed_on.iso8601 }, class: "entry-action" %>
        <%= form_with url: schedule_entry_path(entry), class: "entry__schedule" do |form| %>
          <%= form.hidden_field :viewed_on, value: viewed_on.iso8601 %>
          <%= form.label :date, "Schedule date", class: "visually-hidden" %>
          <%= form.date_field :date, required: true, aria: { label: "Schedule date" } %>
          <%= form.submit "Schedule", class: "entry-action" %>
        <% end %>
      <% elsif entry.state.in?(%w[done struck]) %>
        <%= button_to "Reopen", reopen_entry_path(entry), params: { viewed_on: viewed_on.iso8601 }, class: "entry-action" %>
      <% end %>
    </div>
  <% end %>

  <% children = entry.children.kept %>
  <% if children.any? %>
    <div class="entry__children">
      <%= render partial: "entries/entry", collection: children, locals: { viewed_on: viewed_on } %>
    </div>
  <% end %>
</article>
