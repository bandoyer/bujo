# Secrets are pulled from local files, the gh keyring, and 1Password at deploy
# time; nothing sensitive lives in this file and it stays safe for git.

# GHCR push/pull uses the gh CLI's token (needs the write:packages scope).
KAMAL_REGISTRY_PASSWORD=$(gh auth token)

RAILS_MASTER_KEY=$(cat config/master.key)

# Sending-only Resend key, restricted in Resend to bujo.blackcat.dev. The
# credential remains in 1Password and is resolved only on the deploy machine.
RESEND_API_KEY=$(op read 'op://Personal/bujo-production/credential')

# R2 credentials for Litestream, saved as KEY=VALUE lines (mode 600, never
# committed) by the operator: see PLAN.md's deploy notes.
R2_ACCOUNT_ID=$(grep '^R2_ACCOUNT_ID=' ~/.config/cloudflare/bujo-r2-credentials | cut -d= -f2)
LITESTREAM_ACCESS_KEY_ID=$(grep '^ACCESS_KEY_ID=' ~/.config/cloudflare/bujo-r2-credentials | cut -d= -f2)
LITESTREAM_SECRET_ACCESS_KEY=$(grep '^SECRET_ACCESS_KEY=' ~/.config/cloudflare/bujo-r2-credentials | cut -d= -f2)
